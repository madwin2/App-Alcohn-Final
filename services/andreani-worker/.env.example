# Puerto HTTP (distinto de micorreo-worker 8787)
PORT=8788

# Protección del worker (Authorization: Bearer ... o x-api-key)
WORKER_API_KEY=cambiar-por-un-secreto-largo

# Credenciales portal Pymes Andreani (Azure B2C)
ANDREANI_USER=tu@email.com
ANDREANI_PASS=tu-contraseña

# Texto para buscar en el mapa de origen (usar dirección completa de MDP)
# ⚠️ No poner solo "Independencia" — Andreani sugiere Córdoba
ANDREANI_SUCURSAL_DESPACHO=Alberti 1254, Mar Del Plata
# Nombre parcial de la card a elegir en los resultados
ANDREANI_SUCURSAL_NOMBRE=Sucursal Mar Del Plata

# Paquete estándar (sello)
ANDREANI_PAQUETE_ALTO=25
ANDREANI_PAQUETE_ANCHO=8
ANDREANI_PAQUETE_LARGO=8
ANDREANI_PAQUETE_PESO=1000
ANDREANI_VALOR_DECLARADO=40000
ANDREANI_CODIGO_DESCUENTO=ANDREANI20

# URLs
ANDREANI_HOME_URL=https://pymes.andreani.com/
ANDREANI_LOGIN_URL=https://pymes.andreani.com/

# Playwright
# En Hetzner (EU) Andreani bloquea IPs de datacenter → hace falta proxy residencial AR
ANDREANI_PROXY_SERVER=
ANDREANI_PROXY_USERNAME=
ANDREANI_PROXY_PASSWORD=
ANDREANI_HEADLESS=true
ANDREANI_TIMEOUT_MS=60000
ANDREANI_SLOW_MO_MS=0

# Supabase (inserta links en envios_andreani_links)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Sesión Playwright persistida (login reutilizable)
ANDREANI_STORAGE_STATE_PATH=./data/storage-state.json
ANDREANI_ARTIFACTS_DIR=./artifacts
# Logo Alcohn para el pie de la etiqueta (opcional)
ANDREANI_LOGO_PATH=../../public/logo-alcohn.jpg
