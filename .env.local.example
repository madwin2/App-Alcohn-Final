# Worker MiCorreo (Hetzner) — proxy desde la app
# En Vercel: Project Settings → Environment Variables
MICORREO_WORKER_URL=https://webhook.alcohncnc.com/micorreo
MICORREO_WORKER_API_KEY=el-mismo-valor-que-WORKER_API_KEY-en-hetzner
VECTOR_WORKER_URL=https://webhook.alcohncnc.com/vector
VECTOR_WORKER_API_KEY=el-mismo-valor-que-VECTOR_WORKER_API_KEY-en-hetzner

# Worker Andreani (Hetzner) — proxy desde la app (botón "Generar más")
ANDREANI_WORKER_URL=https://webhook.alcohncnc.com/andreani
ANDREANI_WORKER_API_KEY=el-mismo-valor-que-WORKER_API_KEY-en-hetzner-andreani

# Vectorización automática al subir archivo base (false = desactivado)
VITE_VECTOR_AUTO_ENABLED=false
VECTOR_AUTO_ENABLED=false

# Vectorizer.AI — SOLO servidor, nunca VITE_
VECTORIZER_API_ID=xxxxxxxxxxxxxxx
VECTORIZER_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 'production' = 1 crédito. 'test' = gratis con marca de agua (para probar presets).
VECTORIZER_DEFAULT_MODE=production

# Habilita la pestaña /vectorizacion
VITE_VECTORIZACION_ENABLED=true
